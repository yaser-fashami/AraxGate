@section Scripts{
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/assets/js/custom/apps/user-management/users/list/tableVessel.js"></script>
    <script src="~/assets/js/custom/apps/oiltankgateoperation.js" asp-append-version="true"></script>
    <script src="~/lib/jquery.print/jquery.print.min.js"></script>

    <script src="~/assets/plugins/doughnutchart.js"></script>
    <script src="~/assets/plugins/global/persian-date.min.js"></script>
    <script src="~/assets/js/apexchart3.js"></script>
    <script type="text/javascript">
        if ('@ViewData["role"]' == "admin") {
            $('#weight').removeAttr('disabled');
            $('#weightOut').removeAttr('disabled');
        }


        $(document).ready(function () {
            setTimeout(function () {
                $('#plateContent').css('visibility', 'visible')
                $('#plateContent').hide();
                $('#plateContent').fadeIn();
            }, 500)

        });


        function getWeekDates(year, month, weekNumber) {

            const dayNames = [
                "شنبه",
                "یکشنبه",
                "دوشنبه",
                "سه‌شنبه",
                "چهارشنبه",
                "پنجشنبه",
                "جمعه"
            ];

            // روز اول ماه شمسی
            let firstDay = new persianDate([year, month, 1]);

            // تبدیل به Date میلادی
            let firstGregorian = firstDay.toDate();

            // روز هفته در JS:
            // 0 یکشنبه ... 6 شنبه
            // تبدیل به شنبه=0
            let weekDay = (firstGregorian.getDay() + 1) % 7;

            // شروع هفته اول
            let start = new Date(firstGregorian);
            start.setDate(start.getDate() - weekDay);

            // رفتن به هفته مورد نظر
            start.setDate(start.getDate() + ((weekNumber - 1) * 7));


            let result = [];

            for (let i = 0; i < 7; i++) {

                let current = new Date(start);

                current.setDate(start.getDate() + i);


                let p = new persianDate(current);


                result.push({
                    dayName: dayNames[(current.getDay() + 1) % 7],
                    date: p.format("YYYY/MM/DD"),
                    year: p.year(),
                    month: p.month(),
                    day: p.date(),
                    isCurrentMonth: p.month() === month
                });
            }

            return result;
        }

        $("#week,#month,#year").change(function () {
            $("#tabDayList > li").remove();
            $("#tabDayList").append($("#tabDayListTemp").html());
            dayListAction();

            $('a').removeClass("active");
            $('#selectedDay').text('');
            $('#dounutContent').html('');
            totalInWeek();
            weekEnteranceFetch();
             $('#plateContent').html('');
        });

        function monthsMapFarsi(m){
            let res;
            switch(m){
                case 1:res = "فروردین"
                break;
                case 2:res = "اردیبهشت"
                break;
                case 3:res = "خرداد"
                break;
                case 4:res = "تیر"
                break;
                case 5:res = "مرداد"
                break;
                case 6:res = "شهریور"
                break;
                case 7:res = "مهر"
                break;
                case 8:res = "آبان"
                break;
                case 9:res = "آذر"
                break;
                case 10:res = "دی"
                break;
                case 11:res = "بهمن"
                break;
                case 12:res = "اسفند"
                break;
            }
            return res;
        }
        function monthsMap(m){
            let res;
            switch(m){
                case 1:res = "FAR"
                break;
                case 2:res = "ORD"
                break;
                case 3:res = "KHO"
                break;
                case 4:res = "TIR"
                break;
                case 5:res = "MOR"
                break;
                case 6:res = "SHA"
                break;
                case 7:res = "MEH"
                break;
                case 8:res = "ABA"
                break;
                case 9:res = "AZA"
                break;
                case 10:res = "DEY"
                break;
                case 11:res = "BAH"
                break;
                case 12:res = "ESF"
                break;
            }
            return res;
        }

        function datesPlacement(week, month){
            for(let i = 0; i < 7; i++){
                $(`#day_${i} span:nth-child(2)`).text(week[i].day);
                $(`#day_${i} span:nth-child(3)`).text(monthsMap(week[i].month));
                $(`#day_${i} > a`).data('date', week[i]);
            }
        }

        function dayListAction(){
            $('#tabDayList li a').click(function(){
            $("#dounutContent > div").remove();
            $("#dounutContent").append($("#donutChartTemp").html());
            var date = $(this).data('date');

            let selected = {
                year: date.year,
                month: date.month,
                day: date.day
            };

            let gregorian = new persianDate([
                selected.year,
                selected.month,
                selected.day
            ]).toDate();


            let requestDate = {
                year: gregorian.getFullYear(),
                month: gregorian.getMonth() + 1,
                day: gregorian.getDate()
            };

                $.ajax({
                    url: '/api/dashboard/dounutChart',
                    type: 'GET',
                    data: {
                            day: date.day,
                            month: date.month,
                            year: date.year
                          },
                    success: function(res){
                        $('#totalAmount').text(res.enteranceCount);
                        $('#exitedAmount').text(res.exitedCount);
                        $('#notExitedAmount').text((res.enteranceCount - res.exitedCount));
                        $('#notExitedLately').text(res.notExitedLately);
                        var data = [res.exitedCount, (res.enteranceCount - res.exitedCount), res.notExitedLately]
                        KTUtil.onDOMContentLoaded(function () {
                            KTDoughnutList.init(data, $('#project_overview_chart'), ['Exited', 'notExited', 'notExitedLately']);
                        });
                        truckEnteranced(requestDate);
                    }
                })

            });

            $('li > a').click(function(){
                var date = $(this).data('date');
                $('#selectedDay').text(date.dayName+' '+date.day+' '+monthsMapFarsi(date.month));
            });
            totalInWeek();
        }

        function totalInWeek(){
            let week = $("#week").val();
            let month = $("#month").val();
            let year = $("#year").val();

            let result = getWeekDates(
                year,
                month,
                week
            );
            let date = {
                fromYear: result[0].year,
                fromMonth: result[0].month,
                fromDay: result[0].day,
                toYear: result[6].year,
                toMonth: result[6].month,
                toDay: result[6].day
            };

            $.ajax({
                url: '/api/dashboard/dounutTotalCount',
                type: 'GET',
                data: date,
                success: function(res){
                    $('#totalInWeek').text(res.totalInWeek);
                }
            })

            datesPlacement(result, month);
        }

        function weekEnteranceFetch(){
            let week = $("#week").val();
            let month = $("#month").val();
            let year = $("#year").val();

            let result = getWeekDates(
                year,
                month,
                week
            );
            let date = {
                fromYear: result[0].year,
                fromMonth: result[0].month,
                fromDay: result[0].day,
            };

            $.ajax({
                url: '/api/dashboard/WeekEnterance',
                type: 'GET',
                data: date,
                success: function(res){
                    createAreaChart(res);
                }
            })

        }

        function truckEnteranced(date){
            $('#plateContent').hide();

            $.ajax({
                url: '/Operation/TruckEnterenced',
                type: 'GET',
                data: date,
                success: function(result) {
                    $('#plateContent').html(result);
                    $('#plateContent').fadeIn();
                },
                error: function() {
                    alert('Error');
                }
            });
        }

    </script>
}